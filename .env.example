# ─────────────────────────────────────────────────────────────────────────────
# EdgePilot AI — environment variables
# Copy to .env.local for local dev. On Netlify: Site configuration → Environment variables.
# NOTHING here is required: the app runs on public, keyless data APIs out of the box.
# Never put secrets in variables that start with NEXT_PUBLIC_ (those are sent to the browser).
# ─────────────────────────────────────────────────────────────────────────────

# --- AI analyst (optional) ----------------------------------------------------
# Anthropic API key for plain-English explanations of signals. https://console.anthropic.com
ANTHROPIC_API_KEY=
# Model override (default: claude-opus-5-5)
AI_MODEL=
# Strongly recommended if ANTHROPIC_API_KEY is set: a passphrase you enter in Settings → AI,
# so strangers who find your URL cannot spend your API credits.
AI_ACCESS_CODE=

# --- Solana RPC (recommended) -------------------------------------------------
# Private RPC used server-side for wallet balance reads (the public endpoint is heavily
# rate-limited). e.g. https://mainnet.helius-rpc.com/?api-key=YOUR_KEY  (https://helius.dev)
SOLANA_RPC_URL=

# --- Optional data providers --------------------------------------------------
# Birdeye: holder counts + trending list for the scanner. https://bds.birdeye.so
BIRDEYE_API_KEY=
# CoinGlass: aggregated BTC liquidation totals. https://www.coinglass.com/pricing
COINGLASS_API_KEY=
# Jupiter: higher quote rate limits (otherwise the free lite API is used). https://portal.jup.ag
JUPITER_API_KEY=

# --- Market data endpoint overrides (rarely needed) ----------------------------
# Binance blocks some regions (e.g. US datacenters). The app falls back to Coinbase/Kraken
# automatically; you can also point these at another compatible endpoint.
BINANCE_BASE_URL=https://data-api.binance.vision
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com

# --- Live execution (OFF by default — leave as false) ---------------------------
# Both must be "true" to enable the wallet-approval swap flow. Even then every transaction
# needs a checklist, typed confirmation, simulation and approval inside Phantom.
ENABLE_LIVE_EXECUTION=false
NEXT_PUBLIC_ENABLE_LIVE_EXECUTION=false
