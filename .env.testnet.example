# Hyperliquid TESTNET validation — copy to .env.testnet (gitignored) and fill in.
# TESTNET ONLY. Never put a mainnet key or your seed phrase here.
HL_TESTNET=true
# Public address of your TESTNET trading account (not a key).
HL_ACCOUNT_ADDRESS=
# Private key of an API wallet created on app.hyperliquid-testnet.xyz (More -> API).
HL_AGENT_PRIVATE_KEY=
# Must stay false/absent during validation.
LIVE_TRADING_ENABLED=false
